generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  PROVIDER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  provider Provider?
  bookings Booking[]
}

model Provider {
  id          String @id @default(cuid())
  business    String
  category    String
  phone       String
  location    String
  description String

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  services       Service[]
  bookings       Booking[]
  availabilities Availability[]
}

model Service {
  id       String @id @default(cuid())
  name     String
  price    Float
  duration Int

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])

  bookings Booking[]
}

model Booking {
  id     String   @id @default(cuid())
  date   DateTime
  status String

  studentId  String
  providerId String
  serviceId  String

  student  User     @relation(fields: [studentId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])
}

model Availability {
  id String @id @default(cuid())

  day       String
  startTime String
  endTime   String

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, day])
}
